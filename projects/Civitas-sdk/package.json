{
  "name": "@civitas/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Venom/Civitas identity verification API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "algosdk": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "algosdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "algosdk": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
